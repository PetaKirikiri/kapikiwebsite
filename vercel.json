{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/signup-mail",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/signup-mail.js": {
      "maxDuration": 60,
      "regions": [
        "syd1"
      ]
    },
    "api/course.js": {
      "maxDuration": 60,
      "regions": [
        "syd1"
      ]
    },
    "api/training.js": {
      "maxDuration": 60,
      "regions": [
        "syd1"
      ]
    },
    "api/classroom.js": {
      "maxDuration": 30,
      "regions": [
        "syd1"
      ]
    },
    "api/interest.js": {
      "maxDuration": 30,
      "regions": [
        "syd1"
      ]
    },
    "api/signup-admin.js": {
      "maxDuration": 30,
      "regions": [
        "syd1"
      ]
    },
    "api/analytics.js": {
      "maxDuration": 30,
      "regions": [
        "syd1"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/__analytics",
      "destination": "/api/analytics"
    },
    {
      "source": "/__signup_admin",
      "destination": "/api/signup-admin"
    },
    {
      "source": "/__course_interest",
      "destination": "/api/interest"
    },
    {
      "source": "/__word_support",
      "destination": "/api/training?route=__word_support"
    },
    {
      "source": "/__classroom",
      "destination": "/api/classroom"
    },
    {
      "source": "/__website_sentence",
      "destination": "/api/course?route=__website_sentence"
    },
    {
      "source": "/__training_content",
      "destination": "/api/training?route=__training_content"
    },
    {
      "source": "/__training_profile",
      "destination": "/api/training?route=__training_profile"
    },
    {
      "source": "/__training_attempt",
      "destination": "/api/training?route=__training_attempt"
    },
    {
      "source": "/__training_recording",
      "destination": "/api/training?route=__training_recording"
    },
    {
      "source": "/__website_preview_data",
      "destination": "/api/training?route=__website_preview_data"
    },
    {
      "source": "/__connector_shapes",
      "destination": "/api/training?route=__connector_shapes"
    },
    {
      "source": "/__connector_patterns",
      "destination": "/api/training?route=__connector_patterns"
    }
  ]
}
